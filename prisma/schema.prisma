// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS (Standardizing our status and types)
// -----------------------------------------------------------------------------

enum UserRole {
  PENDING
  CANDIDATE
  COMPANY_ADMIN
  SUPER_ADMIN
}

enum EntityStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  INACTIVE
  CLOSED
}

enum ApplicationStatus {
  SENT
  REVIEWED
  INTERVIEWING
  REJECTED
  HIRED
  CANCELED
}

enum ServicePriceType {
  HOURLY
  FIXED
  TO_BE_AGREED
}

enum ServiceStatus {
  ACTIVE
  PAUSED
}

enum TransactionType {
  PAY_PER_POST
  SUBSCRIPTION
  USER_SERVICE_POST
}

enum TransactionStatus {
  PENDING
  APPROVED
  DECLINED
  REFUNDED
}

enum ServicePaymentStatus {
  PENDING
  APPROVED
  DECLINED
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id           String    @id @db.Uuid
  email        String    @unique
  googleId     String?   @unique
  firstName    String
  lastName     String?
  avatarUrl    String?
  phone        String?
  role         UserRole  @default(CANDIDATE)
  city         String?
  birthDate    DateTime?
  resume       String?
  isVerified   Boolean   @default(true)
  otpCode      String?
  otpExpiresAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  devices      Device[]
  companies    Company[]
  applications Application[]
  transactions Transaction[]
  services     Service[]
  preferences  UserPreference?
}

model Company {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  taxId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  jobs          JobVacancy[]
  subscriptions Subscription[]
}

model JobVacancy {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String
  salary      Decimal?     @db.Decimal(10, 2)
  status      EntityStatus @default(DRAFT)
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  location           String?
  contractType       String?
  modality           String   @default("Presencial")
  requirements       String?
  availablePositions Int?                 @default(1)
  paymentStatus      ServicePaymentStatus @default(PENDING)
  isFeatured         Boolean              @default(false)

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  applications Application[]
  transactions Transaction[]
}

model Application {
  id        String            @id @default(uuid()) @db.Uuid
  status    ApplicationStatus @default(SENT)
  appliedAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String     @db.Uuid
  jobVacancy JobVacancy @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

// -----------------------------------------------------------------------------
// MONETIZATION & BILLING 
// -----------------------------------------------------------------------------

model Subscription {
  id               String       @id @default(uuid()) @db.Uuid
  status           EntityStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions Transaction[]
}

model Transaction {
  id                 String            @id @default(uuid()) @db.Uuid
  reference          String            @unique
  wompiTransactionId String?           @unique
  paymentMethodType  String?
  paymentMethodExtra Json?
  amountInCents      Int
  status             TransactionStatus @default(PENDING)
  type               TransactionType   @default(PAY_PER_POST)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  offerId    String?     @db.Uuid
  jobVacancy JobVacancy? @relation(fields: [offerId], references: [id])

  subscriptionId String?       @db.Uuid
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  serviceId String?  @db.Uuid
  service   Service? @relation(fields: [serviceId], references: [id])
}

// -----------------------------------------------------------------------------
// USER SERVICES (talent marketplace)
// -----------------------------------------------------------------------------

model Service {
  id            String               @id @default(uuid()) @db.Uuid
  title         String
  description   String
  municipality  String
  price         Decimal?             @db.Decimal(10, 2)
  priceType     ServicePriceType     @default(FIXED)
  imageUrl      String?
  status        ServiceStatus        @default(ACTIVE)
  viewsCount    Int                  @default(0)
  paymentStatus ServicePaymentStatus @default(PENDING)
  expiresAt     DateTime?
  isFeatured    Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String          @db.Uuid
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  transactions Transaction[]

  @@index([userId])
  @@index([categoryId])
}

model ServiceCategory {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// FUTURE FEATURE: PUSH NOTIFICATIONS
// -----------------------------------------------------------------------------

model Device {
  id        String   @id @default(uuid()) @db.Uuid
  pushToken String   @unique // The unique token generated by FCM / Expo
  platform  String // 'IOS', 'ANDROID', or 'WEB'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // Makes querying tokens for a specific user blazing fast
}

// -----------------------------------------------------------------------------
// FEATURE: USER PREFERENCES (SETTINGS)
// -----------------------------------------------------------------------------

model UserPreference {
  id                 String   @id @default(uuid()) @db.Uuid
  emailTransactional Boolean  @default(true)
  emailMarketing     Boolean  @default(false)
  pushNotifications  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -----------------------------------------------------------------------------
// FEATURE: SYSTEM CONFIGURATIONS
// -----------------------------------------------------------------------------

model SystemConfig {
  id               String   @id @default(uuid()) @db.Uuid
  key              String   @unique
  minVersionCode   Int      @default(1)
  messageEs        String?
  appStatus        String   @default("ACTIVE")
  appStatusMessage String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
